{
    "lexicon": 1,
    "id": "org.atgeo.describeService",
    "defs": {
        "main": {
            "type": "query",
            "description": "Enumerates the collections this gazetteer serves. The list is authoritative: a collection absent from it returns CollectionNotFound from org.atgeo.getCoverage.",
            "output": {
                "encoding": "application/json",
                "schema": {
                    "type": "object",
                    "required": ["did", "collections"],
                    "properties": {
                        "did": {
                            "type": "string",
                            "format": "did",
                            "description": "The DID this deployment identifies as, matching /.well-known/did.json."
                        },
                        "collections": {
                            "type": "array",
                            "items": {"type": "ref", "ref": "#servedCollection"}
                        }
                    }
                }
            }
        },
        "servedCollection": {
            "type": "object",
            "required": ["collection"],
            "properties": {
                "collection": {"type": "string", "format": "nsid"}
            }
        }
    }
}
