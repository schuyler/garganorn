{
    "lexicon": 1,
    "id": "org.atgeo.describeService",
    "defs": {
        "main": {
            "type": "query",
            "description": "Enumerates the tilesets this gazetteer serves and the collections each carries. The list is authoritative: a dataset absent from it returns DatasetNotFound from org.atgeo.getTiles.",
            "output": {
                "encoding": "application/json",
                "schema": {
                    "type": "object",
                    "required": [
                        "did",
                        "tilesets"
                    ],
                    "properties": {
                        "did": {
                            "type": "string",
                            "format": "did",
                            "description": "The DID this service identifies as. Informational: no discovery path resolves it to this service yet."
                        },
                        "maxTiles": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "The most regular tiles a getTiles answer may list before it falls back to overview tiles or BboxTooLarge. Informational: tile zooms are adaptive, so a client cannot predict a box's tile count."
                        },
                        "tilesets": {
                            "type": "array",
                            "items": {
                                "type": "ref",
                                "ref": "#servedTileset"
                            }
                        }
                    }
                }
            }
        },
        "servedTileset": {
            "type": "object",
            "required": [
                "slug",
                "collections"
            ],
            "properties": {
                "slug": {
                    "type": "string",
                    "maxLength": 64
                },
                "collections": {
                    "type": "array",
                    "items": {
                        "type": "ref",
                        "ref": "org.atgeo.defs#collectionRef"
                    },
                    "minLength": 1
                }
            }
        }
    }
}
