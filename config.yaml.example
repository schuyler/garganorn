repo: places.atgeo.org
databases:
  - type: foursquare
    path: db/fsq-osp.duckdb
  - type: overture_place
    path: db/overture-maps.duckdb

tiles:
  max_per_tile: 1000
  memory_limit: 48GB
  collections:
    org.atgeo.places.foursquare:
      slug: foursquare
      manifest: data/foursquare/tiles/current/manifest.duckdb
      # Presence enables tile-backed getRecord for this collection; the value is
      # ignored, since the run directory is derived from `manifest`.
      tiles_dir: data/foursquare/tiles/current
      base_url: https://places.atgeo.org/tiles/foursquare
      source: https://docs.foursquare.com/data-products/docs/access-fsq-os-places
      license: https://docs.foursquare.com/data-products/docs/access-fsq-os-places
    org.atgeo.places.overture.place:
      slug: overture-place
      manifest: data/overture_place/tiles/current/manifest.duckdb
      tiles_dir: data/overture_place/tiles/current
      base_url: https://places.atgeo.org/tiles/overture-place
      source: https://overturemaps.org/
      license: https://docs.overturemaps.org/attribution/
    org.atgeo.places.osm:
      slug: osm
      manifest: data/osm/tiles/current/manifest.duckdb
      tiles_dir: data/osm/tiles/current
      base_url: https://places.atgeo.org/tiles/osm
      source: https://www.openstreetmap.org/
      license: https://opendatacommons.org/licenses/odbl/1-0/
  max_coverage_tiles: 50

# Two runs are retained and tiles serve max-age=604800, so a build interval
# under about 3.5 days would delete a run while clients still hold its URLs
# as fresh.
pipeline:
  output: data
  memory_limit: 48GB
  temp_directory: /tmp/duckdb
  max_temp_directory_size: 250GB
  max_per_tile: 1000
  bbox: null
  sources:
    overture_division:
      division_parquet: db/cache/overture/*/division/*.parquet
      division_area_parquet: db/cache/overture/*/division_area/*.parquet
    overture_place:
      parquet: db/cache/overture/*/part-*.parquet
    osm:
      parquet_dir: db/cache/osm/parquet
    foursquare:
      parquet: db/cache/fsq/*/places-*.parquet
